REPIT_PORT=8080
SECRET_KEY=repit-local-only-change-this-secret-key
INTERNAL_KEY=repit-local-internal
POSTGRES_PASSWORD=postgres_local
IDENTITY_DB_PASSWORD=identity_local
GROUPS_DB_PASSWORD=groups_local
CATALOG_DB_PASSWORD=catalog_local
ATTEMPTS_DB_PASSWORD=attempts_local
BROKER_PASSWORD=repit_rabbit_local

# OpenRouter Chat Completions в режиме JSON. Пустой ключ отключает генерацию.
AI_API_KEY=
AI_MODEL=google/gemma-4-26b-a4b-it:free
# Базовый адрес API. Сервис добавляет /chat/completions.
AI_BASE_URL=https://openrouter.ai/api/v1
# Для модели с поддержкой строгой схемы укажите json_schema.
AI_RESPONSE_FORMAT=json_object
